FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HERMES_HOME=/root/.hermes

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    curl \
    git \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install LangGraph, LiteLLM, Tenacity, pytest, and provider SDKs
RUN pip install --no-cache-dir \
    "langgraph>=0.2.60" \
    "langgraph-checkpoint-sqlite>=2.0.0" \
    "langchain-google-genai>=2.0.0" \
    "langchain-anthropic>=0.3.0" \
    "langchain-core>=0.3.0" \
    "litellm>=1.60.0" \
    "tenacity>=9.0.0" \
    "pydantic>=2.10.0" \
    "pyyaml>=6.0.2" \
    "pytest>=8.3.0"

# Install NousResearch/hermes-agent from GitHub (shallow clone for fast build)
RUN git clone --depth 1 https://github.com/NousResearch/hermes-agent.git /opt/hermes-agent \
    && pip install --no-cache-dir -e /opt/hermes-agent || true

# Copy our in-container harness entrypoints
COPY eval_runner/agents/container_langgraph.py /opt/eval_agents/container_langgraph.py
COPY eval_runner/agents/container_hermes.py /opt/eval_agents/container_hermes.py

WORKDIR /workspace
CMD ["sleep", "infinity"]
